# Cabeceras para Cloudflare Pages (se copia tal cual a la raíz del build).
# Pages sirve por defecto todo con "max-age=0, must-revalidate" (index.html,
# manifest y service worker incluidos), así que las actualizaciones de la PWA
# llegan siempre. Solo los ficheros con hash en el nombre se cachean un año.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/main-*
  Cache-Control: public, max-age=31536000, immutable

/chunk-*
  Cache-Control: public, max-age=31536000, immutable

/polyfills-*
  Cache-Control: public, max-age=31536000, immutable

/styles-*
  Cache-Control: public, max-age=31536000, immutable
